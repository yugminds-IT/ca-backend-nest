# ===========================================
# NestJS CAA Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# Do not commit .env (it should be in .gitignore).

# -------------------------------------------
# Database (required)
# -------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/ca_db

# Optional: DB connection tuning
DB_SSL=false
DB_POOL_SIZE=20
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT=30

# -------------------------------------------
# JWT / Auth (required)
# -------------------------------------------
SECRET_KEY=replace-with-a-random-64-char-hex-secret
# Optional: use JWT_SECRET if different from SECRET_KEY
# JWT_SECRET=your-jwt-secret

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Master Admin Login
MASTER_ADMIN_EMAIL=master@example.com
MASTER_ADMIN_PASSWORD=password123

# -------------------------------------------
# App
# -------------------------------------------
NODE_ENV=development
PORT=5000
ENVIRONMENT=development
AI_ENGINE_URL=http://localhost:8000

# Optional: base64 key for encrypting stored client passwords (so they can be shown until user changes password).
# If not set, SECRET_KEY is used to derive an encryption key.
# ENCRYPTION_KEY=your-base64-32-byte-key

# Comma-separated allowed origins for CORS (e.g. http://localhost:3000,https://app.example.com)
CORS_ORIGINS=http://localhost:3000

# Used in emails (e.g. login URL, reset links)
FRONTEND_URL=http://localhost:3000

# -------------------------------------------
# SMTP (optional – emails disabled if not set)
# -------------------------------------------
# Defaults below match the project default setup; override in `.env` if needed.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@example.com

# REQUIRED: encrypts per-org SMTP passwords in the database. The app will not start without it.
# Never change it after saving SMTP settings, or stored passwords stop decrypting.
# Comma-separated addresses for Lekvya team alerts (contact form, signups). Optional; unset = no team alerts.
# CONTACT_TEAM_EMAILS=team@example.com

# Optional. Redis (BullMQ) for the email dispatch queue. Without it, queued mail is held in
# memory and lost on restart. Example: redis://localhost:6379
# REDIS_URL=redis://localhost:6379
# SMTP_ENCRYPTION_KEY=

# -------------------------------------------
# AWS S3 (optional – file uploads need this)
# -------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# Optional: custom S3 endpoint (e.g. MinIO, DigitalOcean Spaces)
# AWS_S3_ENDPOINT_URL=https://your-s3-endpoint.example.com

# AWS_REGION is also used by S3

# --- AI assistant (optional). Leave AI_API_KEY empty to use built-in rules only. Any OpenAI-compatible API works.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- SMS and WhatsApp via Twilio (optional). Each channel turns on when its sender number is set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Shared secret sent to the AI engine in X-API-Key. Must equal the AI engine's API_KEY.
# Generate one with: openssl rand -hex 32
AI_ENGINE_API_KEY=e7d0537cb2dd0241d79fcac83593efa9aa790716945e296e996b2699a805ccdf

# Number of reverse proxies in front of the API (usually 1 in production), so login rate limits
# see the real client IP. Leave empty when clients connect directly.
TRUST_PROXY=
